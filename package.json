{
  "name": "ai-commit-generator",
  "displayName": "ai-commit-generator",
  "description": "Generate detailed Git commit messages from staged changes using AI",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.107.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onView:aiCommitConfig"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ai-commit-container",
          "title": "AI Commit Generator",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "ai-commit-container": [
        {
          "id": "aiCommitConfig",
          "name": "Configuration"
        }
      ]
    },
    "commands": [
      {
        "command": "ai-commit-generator.generateCommit",
        "title": "Generate AI Commit Message",
        "icon": "$(sparkle)"
      },
      {
        "command": "ai-commit-generator.openConfig",
        "title": "Open AI Commit Configuration"
      },
      {
        "command": "ai-commit-generator.setProvider",
        "title": "Set AI Provider"
      },
      {
        "command": "ai-commit-generator.setApiKey",
        "title": "Set API Key"
      },
      {
        "command": "ai-commit-generator.setModel",
        "title": "Set Model"
      }
    ],
    "menus": {
      "scm/title": [
        {
          "command": "ai-commit-generator.generateCommit",
          "group": "navigation",
          "when": "scmProvider == git"
        }
      ]
    },
    "configuration": {
      "title": "AI Commit Generator",
      "properties": {
        "aiCommitGenerator.provider": {
          "type": "string",
          "enum": [
            "openai",
            "deepseek",
            "gemini",
            "claude"
          ],
          "default": "gemini",
          "description": "AI provider to use for commit message generation"
        },
        "aiCommitGenerator.model": {
          "type": "string",
          "default": "",
          "description": "Model to use (leave empty for auto-selection)"
        },
        "aiCommitGenerator.commitStyle": {
          "type": "string",
          "enum": [
            "concise",
            "detailed",
            "conventional"
          ],
          "default": "concise",
          "enumDescriptions": [
            "Short, single-line commits (like GitHub Copilot)",
            "Detailed commits with explanations",
            "Conventional commits with type prefixes (feat:, fix:, etc.)"
          ],
          "description": "Style of commit messages to generate"
        },
        "aiCommitGenerator.maxLength": {
          "type": "number",
          "default": 72,
          "minimum": 50,
          "maximum": 200,
          "description": "Maximum length of commit message"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.107.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "esbuild": "^0.27.1",
    "eslint": "^9.39.1",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.1"
  },
  "dependencies": {
    "@google/genai": "^1.34.0"
  }
}
